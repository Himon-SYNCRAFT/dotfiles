#!/bin/bash
# focus-window <pid> — focus the Hyprland window belonging to a process PID.
# Hyprland 0.55+ parses `hyprctl dispatch` as one Lua expression and the
# compositor resolves the pid:… window selector at dispatch time — addresses
# are volatile, never store them.

pid=${1:?usage: focus-window <pid>}
case $pid in ''|*[!0-9]*) exit 1 ;; esac

hyprctl dispatch "hl.dsp.focus({ window = 'pid:$pid' })" >/dev/null 2>&1

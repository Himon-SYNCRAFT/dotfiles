#!/bin/bash
# agents-widget — render the waiting-agents counter for waybar.
#
# waybar calls it with no args (return-type: json, updated by SIGRTMIN+8 from
# agent-hook, never polled):
#   {"text": "<n|0|empty>", "tooltip": "<lines>", "class": "notify|done|none"}
# `agents-widget lines` prints one "pid<TAB>agent · project (status)" row per
# waiting session — the picker's (agents-pick) data source.
#
# Lazy pruning at render: a state file whose terminal PID is dead means the
# session is gone — remove it, no ghosts (spec story 9). pid 0 = terminal
# never found → kept (not dead, just unclickable).

SHOW_ZERO=${SHOW_ZERO:-1}  # 0 = hide module at zero (waybar: hide-empty-text); 1 = show "0"

statedir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agents

waiting() {  # prune dead PIDs; emit "pid<TAB>agent · project (status)" rows
    local f pid
    for f in "$statedir"/*.json; do
        [ -e "$f" ] || continue
        pid=$(jq -r .pid "$f" 2>/dev/null) || continue
        if [ "$pid" -gt 0 ] 2>/dev/null && ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$f"; continue
        fi
        jq -r 'select(.event == "notify" or .event == "done")
               | [.pid, (.agent + " · " + .project + " (" +
                 (if .event == "notify" then "czeka" else "gotowe" end) + ")")]
               | @tsv' "$f" 2>/dev/null
    done
}

if [ "${1:-}" = lines ]; then waiting; exit 0; fi

mapfile -t rows < <(waiting)
n=${#rows[@]}

text=0 tooltip='' class=none
if [ "$n" -gt 0 ]; then
    text=$n
    tooltip=$(printf '%s\n' "${rows[@]}" | cut -f2 \
              | sed 's/ (\([^)]*\))$/ — \1/')
    printf '%s\n' "${rows[@]}" | grep -q '(czeka)' && class=notify || class=done
fi
[ "$n" -eq 0 ] && [ "$SHOW_ZERO" != 1 ] && text=''

jq -nc --arg text "$text" --arg tooltip "$tooltip" --arg class "$class" \
    '{text: $text, tooltip: $tooltip, class: $class}'
